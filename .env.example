# ==============================================================================
# PuneSetu (पुणे सेतू) — Environment Configuration Template
# Copy to .env.local or .env for local development
# NEVER commit production passwords, tokens, or credentials into source control.
# ==============================================================================

# Node Environment
NODE_ENV="development"
PORT=3000

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/punesetu?schema=public"

# ------------------------------------------------------------------------------
# 2. Session & Cryptographic Secrets
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret string used for HMAC-SHA256 JWT signing
SESSION_SECRET="punesetu-dev-secret-change-in-production-must-be-at-least-32-chars"

# ------------------------------------------------------------------------------
# 3. Secure Administrator Provisioning Defaults
# ------------------------------------------------------------------------------
# Used exclusively by `scripts/provision-admin.js` to create the initial admin
ADMIN_EMAIL="admin@punesetu.gov.in"
ADMIN_PASSWORD="ChangeMe@Pune2026!"
ADMIN_NAME="PMC Municipal Commissioner"

# ------------------------------------------------------------------------------
# 4. Optional Storage & Notification Settings (Roadmap)
# ------------------------------------------------------------------------------
# STORAGE_PROVIDER="local" # "local" | "s3" (Reserved for Version 5 file evidence)
